config BT_CONN_TX_MAX
	int

# The kscan API was removed from Zephyr after 4.1; ZMK's matrix drivers
# still use it. Same symbols as Zephyr 4.1 drivers/kscan/Kconfig; the
# header comes from zmkfirmware/zephyr v4.1.0+zmk-fixes.
menuconfig KSCAN
	bool "Keyboard scan drivers (ZMK compatibility)"

if KSCAN

module = KSCAN
module-str = kscan
source "subsys/logging/Kconfig.template.log_config"

config KSCAN_INIT_PRIORITY
	int "Keyboard scan driver init priority"
	default 90

endif # KSCAN
