config TLSR_HOT_TEXT_PAD
	int "Bytes left free after a board's hot text"
	default 0
	help
	  A board's hot_text.ld ends with this many unused bytes, which moves
	  everything linked after the hot text to other lines of the flash
	  instruction cache (64 lines of 32 bytes, direct-mapped): the GPIO
	  driver's API table and the ports' device structures among it, which
	  the key scan reads at every GPIO call together with the configs the
	  hot text holds. A multiple of 32 with which tc32/scripts/hot_slots.py
	  finds none of them in a cache slot of another or of the scan's code;
	  hot_slots.py --pads names the values that would do for a build.

config TLSR_HOT_TEXT_CHECK
	bool "Fail the build when the key scan's constants share a cache slot"
	help
	  tc32/scripts/build.sh runs tc32/scripts/hot_slots.py on the linked
	  image and fails when a constant the key scan reads lies in a cache
	  slot of the scan's code or of another of these constants. For the
	  builds whose TLSR_HOT_TEXT_PAD is kept right.

config TLSR_USB_SUSPEND
	bool "Suspend the chip while the host suspends USB"
	default y
	depends on SOC_TLSR8278 && ZMK_USB
	depends on DT_HAS_ZMK_KSCAN_GPIO_MATRIX_ENABLED || DT_HAS_CIDOO_LED_KEY_MATRIX_ENABLED
	select SOC_TLSR8278_SUSPEND
	help
	  src/usb_suspend.c: after TLSR_USB_SUSPEND_DELAY_MS of USB suspend,
	  the matrix columns are driven active, the rows wake the chip on a change,
	  and the chip suspends until a key, the host's resume or
	  TLSR_USB_SUSPEND_WAKE_MS. A key pressed while the bus is suspended
	  asks the host to wake up (remote wakeup, if the host allows it).

if TLSR_USB_SUSPEND

