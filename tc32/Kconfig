	default 6
	range 6 3200

config TLSR_BLE_CONN_LATENCY
	int "Peripheral latency asked for, in connection events"
	default 44
	range 0 499

config TLSR_BLE_CONN_TIMEOUT
	int "Supervision timeout asked for, in 10 ms units"
	default 300
	range 10 3200

config TLSR_BLE_DIS_MANUFACTURER
	string "Manufacturer Name String in the Device Information service"
	default ""
	help
	  Empty: none. A name adds the characteristic after the PnP ID,
	  which moves every later attribute handle by two; hosts bonded
	  before learn of it from Service Changed.

config TLSR_BLE_DIS_MANUFACTURER_ON
	def_bool TLSR_BLE_DIS_MANUFACTURER != ""

config TLSR_BLE_CONN_FALLBACK
	bool "A second connection parameter request after a rejection"
	default y
	help
	  When the central rejects the TLSR_BLE_CONN_* request, the keyboard
	  asks once more, 30 s later (TGAP(conn_param_timeout), Core Vol 3
	  Part C 9.3.9.2), with the TLSR_BLE_CONN_FALLBACK_* values. The
	  defaults (15 ms, latency 22, 6 s) are inside the limits of Apple's
	  Accessory Design Guidelines (R31, 58.6: interval min a multiple of
	  15 ms and at least 15 ms, max equal to min at 15 ms, latency 30 or
	  less, timeout 6-18 s and more than three times
	  max x (latency + 1), max x (latency + 1) 6 s or less; the older
	  QA1931 also asks for max x (latency + 1) 2 s or less and a timeout
	  of 6 s at most). Apple hosts reject the 7.5 ms request; without the
	  second request such a link keeps the host's parameters.

config TLSR_BLE_CONN_FALLBACK_INTERVAL
	int "Connection interval of the fallback request, in 1.25 ms units"
	default 12
	range 6 3200
	depends on TLSR_BLE_CONN_FALLBACK

config TLSR_BLE_CONN_FALLBACK_LATENCY
	int "Peripheral latency of the fallback request, in connection events"
	default 22
	range 0 499
	depends on TLSR_BLE_CONN_FALLBACK

config TLSR_BLE_CONN_FALLBACK_TIMEOUT
	int "Supervision timeout of the fallback request, in 10 ms units"
	default 600
	range 10 3200
	depends on TLSR_BLE_CONN_FALLBACK

config TLSR_BLE_DEEP_SLEEP
	bool "Deep sleep while no host connects"
	default y
	select SOC_TLSR8278_SUSPEND
	select SOC_TLSR8278_DEEP_SLEEP
	help
	  src/ble/ble_sleep.c: after TLSR_BLE_RECONNECT_TIMEOUT_S of advertising
	  to a bonded host, TLSR_BLE_PAIRING_TIMEOUT_S of discoverable
	  advertising, or at 0 % on battery, the chip goes into deep sleep; a
	  key or the mode switch wakes it (a boot), and on the V21 power in as
	  well (not on the V75 Pro). Not while ZMK's USB is connected.

config TLSR_BOARD_DEEP_SLEEP_PADS
