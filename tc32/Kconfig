# The legacy usb_dc driver of the TLSR8278's USB device controller
# (drivers/usb/device/usb_dc_b87.c), for the legacy USB device stack.
config USB_DC_TELINK_B87
	bool "USB device controller driver for Telink TLSR8278"
	default y
	depends on USB_DEVICE_DRIVER
	depends on DT_HAS_TELINK_B87_USBD_ENABLED
	help
	  Enable the full-speed USB device controller of the Telink TLSR8278.

config USB_DC_TELINK_B87_IRQ_LINES
	bool "Take the TLSR8278 USB interrupt lines"
	default y
	depends on USB_DC_TELINK_B87
	help
	  Enable the controller's five interrupt lines (EP0 setup, data and
	  status, the data endpoints, bus reset) next to the driver's 1 ms
	  poll. Without this option the driver polls only, and the lines
	  stay masked.

config USB_DC_TELINK_B87_EXTERNAL_POLL
	bool
	depends on USB_DC_TELINK_B87
	help
	  Selected by a board driver that calls usb_dc_b87_poll()
	  (<zephyr/drivers/usb/usb_dc_b87.h>) every millisecond from its
	  own timer interrupt, so that the kernel's timeout processing does not
	  run every millisecond in the system timer interrupt. The driver's
	  poll timer then runs every USB_DC_TELINK_B87_FALLBACK_POLL_MS and polls
	  only when the board has not polled since its last expiry: USB keeps
	  working, slower, when the board's timer stops.

config USB_DC_TELINK_B87_SLOW_POLL
	bool
	depends on USB_DC_TELINK_B87 && !USB_DC_TELINK_B87_EXTERNAL_POLL
	help
	  Selected by a board driver that calls usb_dc_b87_slow_poll()
	  (<zephyr/drivers/usb/usb_dc_b87.h>) around a low-power state in
	  which no host uses the bus: the poll timer then runs every
	  USB_DC_TELINK_B87_SLOW_POLL_MS instead of every millisecond, so that
	  the chip can suspend between its expiries.

config USB_DC_TELINK_B87_SLOW_POLL_MS
	int "Period of the slow poll (ms)"
	default 10
	range 2 20
	depends on USB_DC_TELINK_B87_SLOW_POLL
	help
	  With the poll slowed, the longest gap between polls is one period;
	  USB 2.0 9.2.6.4 gives a request without data, and a status stage,
	  50 ms.

config USB_DC_TELINK_B87_FALLBACK_POLL_MS
	int "Period of the fallback poll with an external poll (ms)"
	default 10
	range 2 20
	depends on USB_DC_TELINK_B87_EXTERNAL_POLL
	help
	  Each expiry runs the kernel's timeout processing in the system timer
	  interrupt, which can hold the board's timer interrupt back (an LED
	  driver's time slots, for example). A longer period costs less and only slows
	  USB when the board's timer has stopped. With the board's timer stopped
	  the longest gap between polls is two periods, and USB 2.0 9.2.6.4
	  gives a request without data, and a status stage, 50 ms: hence at
	  most 20. Raise it for a board that needs its timer on time rather
	  than drop the fallback.

config USB_DC_TELINK_B87_SIM
	bool "Route TLSR8278 USB register accesses to a model"
	depends on USB_DC_TELINK_B87 && ARCH_POSIX
	help
	  For host tests on native_sim: the driver calls tlsr_usb_sim_rd8() and
	  tlsr_usb_sim_wr8(), which the test provides, instead of accessing the
	  registers.

config TLSR_USB_OTA
	bool "Telink USB OTA receiver"
	depends on USB_DEVICE_HID && FLASH
	select TLSR_SLOTS
	help
	  Accept firmware images over USB HID report ID 5 with the OTA
	  protocol the original firmware also accepts (telink_ota.py), and write
	  them to the flash slot that is not running. Uses the second HID
	  device (USB_HID_DEVICE_COUNT >= 2) and needs interrupt endpoints of
	  at least 33 bytes (HID_INTERRUPT_EP_MPS).

if TLSR_USB_OTA

config TLSR_USB_OTA_INIT_PRIORITY
	int "Initialization priority"
	default 94
	help
	  The HID device must be registered before ZMK enables USB
	  (ZMK_USB_INIT_PRIORITY).

config TLSR_USB_OTA_SIM_TRIMS
	bool "Flash supply trims from the test (native_sim)"
	depends on TLSR_SLOTS_SIM && !TLSR_SPI_FLASH
	help
	  The receiver raises and puts back the flash supply trims of a Zbit
	  flash as on hardware, through tlsr_spi_flash_trim_raise() and
	  tlsr_spi_flash_trim_restore(), which the test defines as a model.

config TLSR_USB_OTA_STACK_SIZE
	int "Thread stack size"
	default 1152
	help
	  The receiver's thread also runs the confirm's flash test
	  (ble_bond_flash_test(): the bond log read back and compared with
	  RAM, then rewritten), its deepest path: up to about 790 B measured
	  in the emulator with a confirm after a way back and a reinstall.

config TLSR_USB_OTA_THREAD_PRIORITY
	int "Thread priority"
	default 10

config TLSR_USB_OTA_GATE
	bool "An update over an image that checks in the other slot needs the unlock command"
	default y
	help
	  The other slot holds the original firmware after the install (or the
	  previous build): the image the boot guard, the power-on chord and
	  &prev_fw go back to. With this, chunk 0 of an update into that slot
	  is taken while the slot holds an image that checks only after the
	  unlock command (0xff05, which telink_ota.py sends only with
	  --overwrite-other-slot) within TLSR_USB_OTA_ARM_MS; otherwise it is
	  answered with status 13 and nothing is written. That chunk 0 uses
	  the unlock up. With nothing that checks there the update is taken as
	  before (it is then the way back), and the confirm's flash test, which
	  writes the bond log's sectors only, is not held up; neither uses the
	  unlock up, which then lasts until its window ends. No key is needed,
	  so this receiver stays a way back when the keys do not work.

config TLSR_USB_OTA_ARM_MS
	int "How long the unlock holds (ms)"
	default 10000
	range 100 60000
	depends on TLSR_USB_OTA_GATE
	help
	  telink_ota.py sends the start command and chunk 0 right after the
	  unlock; the window only has to cover that.

module = TLSR_USB_OTA
module-str = tlsr_usb_ota
source "subsys/logging/Kconfig.template.log_config"

endif # TLSR_USB_OTA

config TLSR_BOOT_GUARD
	bool "Go back to the other slot's image after repeated watchdog resets"
	depends on FLASH
	select TLSR_SLOTS
	help
	  Runs the Timer2 watchdog, counts the boots that follow a watchdog
	  reset, and after TLSR_BOOT_GUARD_RESETS of them without a healthy
	  boot in between makes the image in the other slot boot.

if TLSR_BOOT_GUARD

config TLSR_BOOT_GUARD_OFFSET
	hex "Flash offset of the reset counter sector"
	default 0x68000

config TLSR_BOOT_GUARD_RESETS
	int "Watchdog resets before going back"
	default 3

config TLSR_BOOT_GUARD_EARLY
	bool "Count and revert from the board's early-init hook, before the kernel"
	depends on TLSR_SPI_FLASH
	default y
	help
	  tlsr_boot_guard_early(), which the board calls from
	  board_early_init_hook() (right after the SoC setup, before any device
	  or thread), finishes an interrupted revert, counts the boot and
	  reverts after TLSR_BOOT_GUARD_RESETS of them, through the flash
	  routines of src/tlsr_spi_flash.c (no driver is ready yet). So an
	  image that hangs anywhere after the SoC setup, even before the
	  kernel, is reset by the SoC's early watchdog, counted, and left.
	  Without this, the counting happens at POST_KERNEL and a hang before
	  that is never counted.

config TLSR_BOOT_GUARD_UNLOCK
	bool "Clear the flash's block protection at boot"
	depends on TLSR_SPI_FLASH
	default y
	help
	  Before its first flash write the boot guard reads the flash status
	  register and, when block-protect bits are set (the original firmware
	  locks the low 256 KB, both slots, with 0x18 at boot and unlocks at
	  its OTA start), clears them for GD25LD40C/80C and ZB25WD40B/80B
	  by JEDEC ID (one status byte, mask 0x1c; any other ID: nothing
	  written) and reads the register again. The register
	  as found and as left is in the OTA version reply (telink_ota.py
	  info). The image does not lock the flash again.

config TLSR_BOOT_GUARD_CHORD
	bool "A key chord held at power-on goes back to the other image"
	depends on TLSR_BOOT_GUARD_EARLY
	help
	  In the early stage, before the kernel, the two keys of the chord
	  (each a row and a column of the kscan matrix, read with active-low
	  rows by the column driven low and the row on its pull-up, with
	  active-high rows by the column driven high and the row on its
	  pull-down) are
	  read three times 1 ms apart; held, the image in the other slot is
	  made to boot, whatever the count. So an image whose USB does not
	  work, or that no host tool can reach, can still be left without a
	  tool, as long as it gets this far.

if TLSR_BOOT_GUARD_CHORD

config TLSR_BOOT_GUARD_CHORD_ROW
	int "The first key's row (index into the kscan node's row-gpios)"

config TLSR_BOOT_GUARD_CHORD_COL_A
	int "The first key's column (index into col-gpios)"

config TLSR_BOOT_GUARD_CHORD_ROW_B
	int "The second key's row (index into row-gpios)"
	default TLSR_BOOT_GUARD_CHORD_ROW

config TLSR_BOOT_GUARD_CHORD_COL_B
	int "The second key's column (index into col-gpios)"

config TLSR_BOOT_GUARD_CHORD_AFTER_COUNT
	bool "Read the chord after this boot is counted"
	help
	  The chord is read after count_boot() instead of before it. Before
	  the first count a hang cannot be recovered (the early watchdog
	  resets into the same code, and nothing counts); after it, a boot of
	  an unconfirmed image is counted, and the boot guard goes back after
	  TLSR_BOOT_GUARD_RESETS of them. So a board whose chord code (its
	  pins and polarity) has not run on hardware keeps it out of the
	  window that nothing recovers, and a new image that hangs there is
	  left before it is confirmed. A confirmed image counts no boot, so
	  for it the order makes no difference. The outcome of a held chord
	  is the same: the revert clears the count (tlsr_boot_guard_forget()),
	  and a boot the firmware asked for still does not read it.

endif # TLSR_BOOT_GUARD_CHORD

config TLSR_BOOT_GUARD_COUNT_ALL_BOOTS
	bool "Count every boot of an unconfirmed image the firmware did not ask for, not only watchdog resets"
	default y
	help
	  Until the host confirms the image, every boot that is not a reboot
	  this firmware asked for (tlsr_reboot()) adds one to the counter:
	  watchdog resets, power-ons and other resets alike. So
	  TLSR_BOOT_GUARD_RESETS power-ons in a row go back to the other image
	  as well: a new image that runs but does not work (USB that does not
	  work, no keys) can be left by cycling the power, with no tool.
	  Without this option only watchdog resets count. A confirmed image
	  counts no boot either way (its way back is the power-on chord or
	  &prev_fw).

choice TLSR_BOOT_GUARD_HEALTHY
	prompt "What makes a boot of a confirmed image healthy (clears the boot count)"
	default TLSR_BOOT_GUARD_HEALTHY_USB if ZMK_USB && !ZMK_BLE
	default TLSR_BOOT_GUARD_HEALTHY_UPTIME
	help
	  A boot that is not healthy counts, and after TLSR_BOOT_GUARD_RESETS
	  of them in a row the image in the other slot boots. Until the host
	  has confirmed the image (the OTA report's 0xff03, telink_ota.py
	  confirm, taken only after the flash test passed in the same boot and
	  while the other slot's image checks: src/tlsr_usb_ota.c) nothing
	  but that confirm clears the count, so
	  a new image must be confirmed within TLSR_BOOT_GUARD_RESETS boots or the
	  keyboard goes back. The confirmation stays with the image; from then
	  on no boot is counted, and this rule only clears a count a flash
	  fault could have left.

config TLSR_BOOT_GUARD_HEALTHY_USB
	bool "The host configured USB"
	depends on ZMK_USB && !ZMK_BLE
	help
	  The counter of a confirmed image is cleared when the host configures
	  the USB device (SET_CONFIGURATION). Not for
	  Zephyr's BLE (ZMK_BLE), where a session may never touch USB. With
	  the own stack (TLSR_BLE) a bonded central's encrypted link with the
	  keyboard report's notifications on marks the boot healthy too
	  (src/ble/ble_zmk.c).

config TLSR_BOOT_GUARD_HEALTHY_UPTIME
	bool "TLSR_BOOT_GUARD_HEALTHY_MS of running"
	help
	  The counter is cleared after that much uptime, whatever the image
	  does; a running image whose USB does not work counts as healthy.

endchoice

config TLSR_BOOT_GUARD_HEALTHY_MS
	int "Uptime that clears the reset counter (ms)"
	default 15000
	help
	  Used with TLSR_BOOT_GUARD_HEALTHY_UPTIME.

config TLSR_BOOT_GUARD_WATCHDOG_MS
	int "Watchdog period (ms)"
	default 4000

config TLSR_BOOT_GUARD_SCLK_HZ
	int "System clock that Timer2 counts (Hz)"
	default 48000000
	help
	  Used only when the guard cannot measure the clock at boot. The
	  TLSR8278 SoC code sets register 0x66 to 0x20: FHS, the 48 MHz
	  clock doubled from the 24 MHz crystal while 0x70[0] and 0x66[7]
	  are 0 (DS-TLSR8278 4.2).

config TLSR_BOOT_GUARD_INIT_PRIORITY
	int "Initialization priority (POST_KERNEL)"
	default 60
	help
	  After the flash driver (FLASH_INIT_PRIORITY).

endif # TLSR_BOOT_GUARD

