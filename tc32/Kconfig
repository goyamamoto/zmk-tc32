	depends on TLSR_USB_OTA && TC32_RNG_ADC
	select TC32_RNG_JITTER_DUMP
	select TC32_RNG_ADC_DUMP
	select TC32_RNG_READINESS
	help
	  src/tlsr_rng_measure.c: the first 1000 jitter samples and 1001 ADC
	  codes after each boot (the restart batch), and runs of one source's
